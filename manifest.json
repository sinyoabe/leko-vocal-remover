{
  "manifest_version": 3,
  "name": "LEKO Vocal Remover Pro",
  "version": "2.0",
  "description": "Pemisah vokal YouTube instan dengan performa tinggi",
  "permissions": ["activeTab"],
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.png"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}